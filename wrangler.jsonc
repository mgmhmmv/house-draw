{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archstudio",
  "main": "worker/index.ts",
  "account_id": "c9ca55db2dd0a7943c76df1484b08162",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Vite build is served as static assets; only /api/* reaches the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // "remote": true — `wrangler dev` uses the cloud D1 and R2 too, so localhost sees the same
  // projects as draw.picadgroup.com. Careful: local edits change live data.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archstudio",
      "database_id": "0e29c08e-27e8-45ec-aa9a-36bd79549ee7",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "archstudio-files",
      "remote": true
    }
  ],
  "routes": [{ "pattern": "draw.picadgroup.com", "custom_domain": true }],
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, or .dev.vars locally): ANTHROPIC_API_KEY, ISLEPOS_KEY_SECRET
}
