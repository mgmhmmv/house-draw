{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archstudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Vite build is served as static assets; only /api/* reaches the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archstudio",
      // Replace with the id from `wrangler d1 create archstudio` before the first remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "archstudio-files"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, or .dev.vars locally): ANTHROPIC_API_KEY
}
