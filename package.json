{
  "name": "archstudio-bim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-Assisted 2D/3D Building CAD, Engineering Drawing Set, Schematics & BOQ Workstation",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply archstudio --local",
    "build": "tsc -b && vite build",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
